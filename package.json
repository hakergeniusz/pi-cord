{
	"name": "pi-cord",
	"version": "0.1.0",
	"description": "Use the Pi coding agent from Discord or Telegram - OpenClaw-style gateway, built as a Pi extension",
	"type": "module",
	"license": "MIT",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"start": "bun run src/main.ts",
		"test": "bun test"
	},
	"dependencies": {
		"discord.js": "^14.16.3"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.99.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^22.10.0",
		"typescript": "^5.7.0"
	}
}
